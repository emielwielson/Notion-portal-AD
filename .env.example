# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Notion API - Internal integration secret from notion.so/my-integrations (starts with secret_ or ntn_)
NOTION_API_KEY=secret_xxxxx

# Notion Database IDs (from Notion URL, part before ?)
# Contacten: https://notion.so/.../2c45ef8caa5480efbd8fdc9df5dfa16e?v=...
# Contacten (pro): https://notion.so/.../2e85ef8caa54806e8573e72bfa44a1d1?v=...
CONTACTEN_DB_ID=2c45ef8caa5480efbd8fdc9df5dfa16e
CONTACTEN_PRO_DB_ID=2e85ef8caa54806e8573e72bfa44a1d1

# Optional: Project title property – use ID (e.g. title) if name lookup fails
# PROJECT_TITLE_PROPERTY_ID=title
# PROJECT_TITLE_PROPERTY_NAME=Naam

# Optional: Data source IDs – needed when using linked views or when API discovery fails
# Notion DB → ••• menu → Manage data sources → Copy data source ID
# CONTACTEN_DATA_SOURCE_ID=
# CONTACTEN_PRO_DATA_SOURCE_ID=

# App URL (auth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
